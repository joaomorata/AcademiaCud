@{
    ViewData["Title"] = "Sobre Nós";
}

<div class="container fade-in mt-4">
    <div class="card p-4 mb-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h2 class="fw-bold text-primary mb-3">Sobre a Academia Cruzadas</h2>
                <p class="lead text-secondary">
                    Na Academia Cruzadas, nosso foco é fortificar guerreiros e transformar vidas através da dedicação, disciplina e do treino de força.
                </p>
                <p>
                    Fundada com a missão de entregar alta performance e saúde, oferecemos equipamentos modernos, um ambiente motivador e uma equipe de instrutores altamente qualificados para acompanhar toda a sua jornada.
                </p>
            </div>
            <div class="col-lg-5 text-center">
                <img src="~/images/fundo.jpg" alt="Academia Cruzadas" class="img-fluid rounded shadow" style="max-height: 280px; width: 100%; object-fit: cover;" />
            </div>
        </div>
    </div>

 
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card p-3 h-100">
                <h4 class="text-primary fw-bold">Missão</h4>
                <p class="mb-0 text-muted">Proporcionar um ambiente de superação física e mental com o melhor acompanhamento profissional.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 h-100">
                <h4 class="text-primary fw-bold">Visão</h4>
                <p class="mb-0 text-muted">Ser referência em alta performance e qualidade de vida na região.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 h-100">
                <h4 class="text-primary fw-bold">Valores</h4>
                <p class="mb-0 text-muted">Disciplina, respeito, superação constante e foco em resultados.</p>
            </div>
        </div>
    </div>
</div>