@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">

    <h1 class="display-5 fw-bold">
        Academia Cruzadas
    </h1>

    <p class="lead text-muted">
        Sistema de Cadastro de Instrutores
    </p>

    <a asp-controller="instrutor"
       asp-action="Index"
       class="btn btn-primary btn-lg mt-3">
        Acessar Cadastro
    </a>

</div>

<hr class="my-5">

<div class="row text-center">

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Cadastro</h4>
                <p>Cadastre novos instrutores.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Consulta</h4>
                <p>Visualize todos os registros.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Gerenciamento</h4>
                <p>Edite ou exclua informações facilmente.</p>
            </div>
        </div>
    </div>

</div>